{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/regaarder-documentary(?:-v[23])?/index.html",
      "dest": "/public/regaarder-documentary/index.html"
    },
    {
      "src": "/regaarder-documentary(?:-v[23])?/(runtime-part[0-9]+\\.js)",
      "dest": "/public/regaarder-documentary/$1"
    },
    {
      "src": "/regaarder-documentary(?:-v[23])?/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
